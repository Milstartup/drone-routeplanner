# Kopieer dit bestand naar .env.local en vul je eigen sleutel in.
# .env.local staat in .gitignore en komt dus niet in git.
#
# Alleen nodig als je satellietbeeld BUITEN Nederland wilt (Esri World Imagery).
# Maak een gratis account op ArcGIS Location Platform (https://location.arcgis.com)
# en een API-sleutel met de bevoegdheid "Basemaps". Beperk de sleutel tot
# http://localhost:5173 als verwijzer (referrer).
VITE_ARCGIS_API_KEY=
